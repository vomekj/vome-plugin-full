{
  "plugin": {
    "prefix": "plugin",
    "scope": "typescript,javascript",
    "body": [
      "// 宿主 loadPluginClass 会剥离该 import，并注入真实 BasePlugin",
      "import { BasePlugin } from 'vome-plugin-runtime'",
      "",
      "/**",
      " * ${1:描述}",
      " */",
      "export class ${2:Xxx}Plugin extends BasePlugin {",
      "  async ready() {",
      "    const cfg = (this.pluginInfo?.config ?? {}) as Record<string, unknown>",
      "    $0",
      "  }",
      "",
      "  async ${3:ping}() {",
      "    return { ok: true, key: this.pluginInfo?.key }",
      "  }",
      "}",
      "",
      "export const Plugin = ${2:Xxx}Plugin",
      ""
    ],
    "description": "BasePlugin + export const Plugin（公开方法名须加入 obfuscator reservedNames）"
  },
  "plugin-method": {
    "prefix": "plugin-method",
    "scope": "typescript,javascript",
    "body": [
      "async ${1:method}(${2:payload}: ${3:unknown}) {",
      "  $0",
      "  return { ok: true }",
      "}"
    ],
    "description": "公开方法：宿主 invoke；方法名须保留"
  },
  "plugin-handlers": {
    "prefix": "plugin-handlers",
    "scope": "typescript,javascript",
    "body": [
      "/** module.json.routes 的 handler 名须与此导出一致；返回 data，勿返回 Response */",
      "export const handlers = {",
      "  async ${1:hello}(ctx: {",
      "    body: unknown",
      "    query: Record<string, string>",
      "    params: Record<string, string>",
      "    headers: Headers",
      "    adminId?: number | string",
      "  }) {",
      "    $0",
      "    return { ok: true, adminId: ctx.adminId }",
      "  },",
      "}",
      ""
    ],
    "description": "HTTP handlers（ModuleHandlerCtx → data；/admin/ext/{key}/…）"
  },
  "plugin-route": {
    "prefix": "plugin-route",
    "scope": "json",
    "body": [
      "{",
      "  \"method\": \"${1|GET,POST,PUT,PATCH,DELETE|}\",",
      "  \"path\": \"/${2:hello}\",",
      "  \"handler\": \"${2:hello}\",",
      "  \"summary\": \"${3:描述}\",",
      "  \"perms\": \"${4:base:ext:hello}\"",
      "}"
    ],
    "description": "module.json.routes 单项（无权限可删 perms 行）"
  },
  "plugin-config": {
    "prefix": "plugin-config",
    "scope": "json",
    "body": [
      "\"config\": {",
      "  \"@local\": {",
      "    \"${1:greeting}\": \"${2:hello-local}\"",
      "  },",
      "  \"@prod\": {",
      "    \"${1:greeting}\": \"${3:hello-prod}\"",
      "  }",
      "}"
    ],
    "description": "module.json 环境配置"
  },
  "plugin-module": {
    "prefix": "plugin-module",
    "scope": "json",
    "body": [
      "{",
      "  \"name\": \"${1:插件名}\",",
      "  \"key\": \"${2:my-full}\",",
      "  \"version\": \"${3:1.0.0}\",",
      "  \"description\": \"${4:描述}\",",
      "  \"author\": \"${5:vome}\",",
      "  \"hook\": \"${6:my-full-hook}\",",
      "  \"singleton\": true,",
      "  \"logo\": \"assets/logo.png\",",
      "  \"readme\": \"README.md\",",
      "  \"config\": {",
      "    \"@local\": {},",
      "    \"@prod\": {}",
      "  },",
      "  \"menus\": [",
      "    {",
      "      \"name\": \"${1:插件名}\",",
      "      \"router\": \"/${2:my-full}\",",
      "      \"appKey\": \"${2:my-full}\",",
      "      \"icon\": \"icon-app\",",
      "      \"orderNum\": 99,",
      "      \"isShow\": true",
      "    }",
      "  ]",
      "}",
      ""
    ],
    "description": "全栈 module.json 骨架（hook + menus；key 不可为 plugin）"
  },
  "plugin-menu": {
    "prefix": "plugin-menu",
    "scope": "json",
    "body": [
      "{",
      "  \"name\": \"${1:菜单名}\",",
      "  \"router\": \"/${2:key}\",",
      "  \"appKey\": \"${2:key}\",",
      "  \"icon\": \"${3:icon-app}\",",
      "  \"orderNum\": ${4:99},",
      "  \"isShow\": true",
      "}"
    ],
    "description": "module.json.menus 单项（appKey = key）"
  },
  "plugin-vue-app": {
    "prefix": "plugin-vue",
    "scope": "vue",
    "body": [
      "<template>",
      "  <main class=\"page\">",
      "    <h1>${1:插件名}</h1>",
      "    <p>$0</p>",
      "  </main>",
      "</template>",
      "",
      "<script setup lang=\"ts\">",
      "defineOptions({ name: '${2:App}' })",
      "</script>",
      "",
      "<style scoped>",
      ".page {",
      "  min-height: 100vh;",
      "  margin: 0;",
      "  display: grid;",
      "  place-items: center;",
      "  text-align: center;",
      "  font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;",
      "  background: #f5f7fb;",
      "  color: #1a1d26;",
      "}",
      "",
      "h1 {",
      "  margin: 0 0 0.5rem;",
      "  font-size: 1.5rem;",
      "  color: #4e5dff;",
      "}",
      "",
      "p {",
      "  margin: 0;",
      "  opacity: 0.75;",
      "}",
      "</style>",
      ""
    ],
    "description": "插件 Vue3 SFC（写在 web-src/，构建到 web/）"
  },
  "plugin-vue-main": {
    "prefix": "plugin-main",
    "scope": "typescript",
    "body": [
      "import { createApp } from 'vue'",
      "import App from './App.vue'",
      "",
      "createApp(App).mount('#app')",
      ""
    ],
    "description": "插件 Vue3 入口 main.ts（web-src/）"
  },
  "plugin-fetch-ext": {
    "prefix": "plugin-fetch-ext",
    "scope": "typescript,javascript",
    "body": [
      "import { hostRequest, extPath } from './lib/host-api'",
      "",
      "const data = await hostRequest('${1|GET,POST|}', extPath('/${2:hello}')${3:, body})",
      ""
    ],
    "description": "前端调本插件 /admin/ext/{key}/…（host-api.ts）"
  },
  "plugin-fetch-admin": {
    "prefix": "plugin-fetch",
    "scope": "typescript,javascript",
    "body": [
      "import { hostRequest } from '@/lib/host-api'",
      "",
      "const data = await hostRequest('${1|GET,POST|}', '${2:/admin/base/auth/me}'${3:, body})",
      ""
    ],
    "description": "微应用 hostRequest 调宿主"
  },
  "plugin-eps": {
    "prefix": "plugin-eps",
    "scope": "typescript,javascript",
    "body": [
      "import { bootHostEps, service } from '@/lib/eps-client'",
      "",
      "await bootHostEps()",
      "// 按宿主 EPS 挂载结果调用 service.<module>…",
      "$0"
    ],
    "description": "可选 EPS：bootHostEps + service"
  },
  "plugin-locale": {
    "prefix": "plugin-t",
    "scope": "typescript,javascript,vue",
    "body": [
      "import { usePluginLocale } from '@/lib/locale'",
      "",
      "const { t } = usePluginLocale()",
      "const label = t('${1:app.name}')"
    ],
    "description": "插件文案 t()（跟随宿主语种；勿做插件内切语言）"
  },
  "plugin-invoke": {
    "prefix": "plugin-invoke",
    "scope": "typescript,javascript",
    "body": [
      "await pluginInfoService.invoke('${1:scaffold-full}', '${2:ping}'${3:, payload})",
      ""
    ],
    "description": "宿主 invoke 本插件公开方法"
  }
}
