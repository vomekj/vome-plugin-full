{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types", "node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["web-src/*"]
    }
  },
  "include": ["src", "web-src/**/*.ts", "web-src/**/*.vue", "vite.config.ts"]
}
